[configuration]

entry_symbol = "example_library_init"
compatibility_minimum = "4.1"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://bin/linux/libmover.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/linux/libmover.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/windows/libmover.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/windows/libmover.windows.template_release.x86_64.dll"
macos.debug = "res://bin/macos/libmover.macos.template_debug.framework"
macos.release = "res://bin/macos/libmover.macos.template_release.framework"
android.debug.arm64 = "res://bin/android/libmover.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/android/libmover.android.template_release.arm64.so"
